{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "strictPropertyInitialization": false,
    "types": ["node", "jest"],
    "baseUrl": ".",
